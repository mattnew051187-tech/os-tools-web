{
  "name": "sos-tools-web",
  "productName": "SOS Tools Web",
  "version": "1.1.0",
  "description": "SOS Tools — central web edition (multi-user, multi-platform)",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e 'console.log(\"Build complete\")'",
    "lint": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');const files=['server.js','store.js','public/app.js','public/js/api.js',...fs.readdirSync('scripts').filter(f=>f.endsWith('.js')).map(f=>p.join('scripts',f)),...fs.readdirSync('test').filter(f=>f.endsWith('.js')).map(f=>p.join('test',f))];for(const f of files){cp.execFileSync(process.execPath,['-c',f],{stdio:'inherit'});}\"",
    "test": "node test/auth-routes.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jspdf": "^4.2.1",
    "mongodb": "^7.7.0"
  }
}
