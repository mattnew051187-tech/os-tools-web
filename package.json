{
  "name": "sos-tools-web",
  "productName": "SOS Tools",
  "version": "1.1.1",
  "description": "SOS Tools — local desktop testing and central web edition",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "start:desktop": "electron .",
    "build": "node -e \"console.log('Server build ready')\"",
    "build:windows": "electron-builder --win nsis --x64 --publish never",
    "lint": "node -c server.js && node -c store.js && node -c desktop/main.js && node -c public/app.js && node -c public/js/api.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "electron-updater": "^6.6.2",
    "jspdf": "^4.2.1",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "uk.co.sostools.desktop",
    "productName": "SOS Tools",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "store.js",
      "public/**/*",
      "modules/**/*",
      "package.json",
      "!data/**/*",
      "!deploy/**/*",
      "!*.bat"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "mattnew051187-tech",
        "repo": "os-tools-web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SOS-Tools-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SOS Tools",
      "deleteAppDataOnUninstall": false
    }
  }
}
